diff --git a/codex-rs/memories/write/src/start.rs b/codex-rs/memories/write/src/start.rs
index ebd0b99..1fdc90c 100644
--- a/codex-rs/memories/write/src/start.rs
+++ b/codex-rs/memories/write/src/start.rs
@@ -30,6 +30,18 @@ pub fn start_memories_startup_task(
     parent_permission_profile: PermissionProfile,
     source: &SessionSource,
 ) {
+    // CL-Bench scheduling adaptation: business sessions do not race their
+    // predecessors' memory jobs. An isolated maintenance launch supplies the
+    // exact completed source thread; no future task is passed to that launch.
+    let boundary_mode = std::env::var("CLBENCH_MEMORY_BOUNDARY_MODE").as_deref() == Ok("1");
+    let boundary_source = std::env::var("CLBENCH_MEMORY_SOURCE_THREAD")
+        .ok()
+        .and_then(|value| ThreadId::from_string(&value).ok());
+    if boundary_mode && boundary_source.is_none() {
+        return;
+    }
+    let consolidation_deferred = boundary_mode
+        && std::env::var("CLBENCH_MEMORY_CONSOLIDATION").as_deref() == Ok("defer");
     if config.ephemeral
         || !config.features.enabled(Feature::MemoryTool)
         || source.is_non_root_agent()
@@ -88,7 +100,22 @@ pub fn start_memories_startup_task(
             // Run phase 1.
             phase1::run(Arc::clone(&context), Arc::clone(&config)).await;
             // Run phase 2.
-            phase2::run(context, config, parent_permission_profile).await;
+            let receipt_path = config.codex_home.join("clbench-memory-pipeline.json");
+            if !consolidation_deferred {
+                phase2::run(context, config, parent_permission_profile).await;
+            }
+            if boundary_mode {
+                // This records pipeline return, not success. The controller must
+                // independently verify jobs, source watermarks, and durable state.
+                let receipt = serde_json::json!({
+                    "source_thread": boundary_source.map(|id| id.to_string()),
+                    "status": "returned_requires_job_verification",
+                    "consolidation_deferred": consolidation_deferred,
+                });
+                if let Err(err) = tokio::fs::write(receipt_path, receipt.to_string()).await {
+                    warn!("failed writing CL-Bench pipeline receipt: {err}");
+                }
+            }
         });
     }
 }
